# ASHA-VAANI Configuration

# Environment
APP_ENV=development
SECRET_KEY=asha_vaani_super_secret_hackathon_key_2026

# Database
DATABASE_URL=sqlite:///./asha_vaani.db

# Official Gnani API Platform Integration
# Model identifiers: Prisma-v3.0 for STT, Timbre-v3.0 for TTS
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_MODEL=Prisma-v3.0
GNANI_TTS_MODEL=Timbre-v3.0
GNANI_WS_URL=wss://api.gnani.ai/v3/speech/stream
GNANI_TTS_URL=https://api.gnani.ai/v3/speech/synthesize
GNANI_LANGUAGE_CODE=en-IN

# Optional LLM integration (interchangeable: groq, gemini, openai, ollama, or local heuristic engine)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=

# Privacy & Audio Retention Policy
AUDIO_RETENTION_ENABLED=false
AUDIO_RETENTION_DAYS=0
LOG_AUDIO_METRICS=true
